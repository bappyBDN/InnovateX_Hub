# Copy to backend/.env.local when you run the API on your machine without Docker.
# These values override the root .env (which is written for the Docker containers).
DATABASE_URL=sqlite:///./data/innovatex.db
UPLOAD_DIR=./data/uploads
# Mailpit from docker compose is reachable on the host port (MAILPIT_SMTP_PORT in the root .env).
SMTP_HOST=localhost
SMTP_PORT=1026
