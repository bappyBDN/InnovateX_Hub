# ─────────────────────────────────────────────────────────────────────────────
# InnovateX Hub — one env file for backend, frontend and Docker.
# Copy to ".env" and change what you need. No URL or port is hard-coded elsewhere.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=InnovateX Hub
ENVIRONMENT=development

# ── Ports on your machine ────────────────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_UI_PORT=8026
MAILPIT_SMTP_PORT=1026

# ── On a server (Dokploy and similar) ────────────────────────────────────────
# Point the domain at the "frontend" service, port 80. The app and the API then share that one address:
#   FRONTEND_URL=https://your.domain   CORS_ORIGINS=https://your.domain   VITE_API_BASE_URL=/api/v1
# No host ports are opened there, so the *_PORT values below only matter on your own machine.

# ── URLs ─────────────────────────────────────────────────────────────────────
# Where the browser reaches the app and the API. Keep the ports in step with the ones above.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
API_PREFIX=/api/v1
# Browser origins allowed to call the API (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Frontend build (Vite reads only VITE_* variables) ────────────────────────
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=InnovateX Hub
VITE_DISPLAY_TIMEZONE=Asia/Dhaka

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Neon: use the pooled connection string, with the project's own database name.
# For a local file instead: DATABASE_URL=sqlite:////data/innovatex.db
DATABASE_URL=postgresql://USER:PASSWORD@HOST/innovatex_hub?sslmode=require
DB_POOL_SIZE=5
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

# ── Auth (local login until Microsoft Entra ID is connected) ─────────────────
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# ── Demo data ────────────────────────────────────────────────────────────────
SIGNUP_ENABLED=true
INVITATION_EXPIRY_DAYS=7
DEMO_MODE=true
SEED_ON_START=true
DEMO_PASSWORD=Password@123

# ── Email ────────────────────────────────────────────────────────────────────
# Real email goes through the company mail server, signed in as the sending mailbox:
#   SMTP_HOST=mail.anwargroup.net   SMTP_PORT=587   SMTP_USER=<the mailbox>   SMTP_PASSWORD=<its password>
# Check it with:  cd backend && python -m app.send_test_email someone@anwargroup.net
# For local testing instead, send to the Mailpit container (SMTP_HOST=mailpit, SMTP_PORT=1025, no user or password)
# and read the emails at http://localhost:${MAILPIT_UI_PORT}. Leave SMTP_HOST empty to only log emails.
SMTP_HOST=mail.anwargroup.net
SMTP_PORT=587
SMTP_USER=aopl.growthanalytics5@anwargroup.net
SMTP_PASSWORD=
# auto = SSL on port 465, otherwise STARTTLS when the server offers it. Or: starttls, ssl, none.
SMTP_SECURITY=auto
MAIL_FROM=aopl.growthanalytics5@anwargroup.net
MAIL_FROM_NAME=InnovateX Hub

# ── Background worker ────────────────────────────────────────────────────────
OUTBOX_POLL_SECONDS=5
DISPLAY_TIMEZONE=Asia/Dhaka
